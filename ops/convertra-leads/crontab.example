# Convertra Leads Pipeline — Cron Schedule
# ─────────────────────────────────────────
#
# Install: crontab -e  (then paste these lines)
# Timezone: Set VPS to AEST or adjust times accordingly
# Logs: mkdir -p /home/ubuntu/convertra-leads/logs
#
# Before enabling cron, verify manually:
#   python3 orchestrator.py daily
#   python3 orchestrator.py weekly
#   python3 orchestrator.py campaign --niches "supplements"

# ─────────────────────────────────────────
# PRIMARY: Daily lead fill (Instantly)
# ─────────────────────────────────────────

# Daily fill: 7am AEST every weekday (Mon-Fri)
# Hunts 25 leads, drafts emails, pushes to Instantly campaign
# Persistent: runs up to 25 rounds with sub-niche expansion to hit target
# Runs BEFORE the 9am sending window so leads are queued and ready
0 7 * * 1-5 cd /home/ubuntu/convertra-leads && python3 orchestrator.py fill --target 25 >> /home/ubuntu/convertra-leads/logs/fill.log 2>&1

# ─────────────────────────────────────────
# SUPPORTING: Inbox monitoring + health checks
# ─────────────────────────────────────────

# Daily routine: 9am AEST every weekday (Mon-Fri)
# Checks inbox for replies/bounces, sends legacy follow-ups, reports via Telegram
0 9 * * 1-5 cd /home/ubuntu/convertra-leads && python3 orchestrator.py daily >> /home/ubuntu/convertra-leads/logs/daily.log 2>&1

# Weekly review: 10am AEST every Monday
# Pipeline health check, red flag detection, auto-pause if bounce rate critical
0 10 * * 1 cd /home/ubuntu/convertra-leads && python3 orchestrator.py weekly >> /home/ubuntu/convertra-leads/logs/weekly.log 2>&1

# Pipeline backup: midnight every Sunday
0 0 * * 0 cd /home/ubuntu/convertra-leads && python3 cli.py pipeline backup >> /home/ubuntu/convertra-leads/logs/backup.log 2>&1

# ─────────────────────────────────────────
# SELF-OPTIMIZING: Email copy A/B testing
# ─────────────────────────────────────────

# Optimization heartbeat: every 30 min on weekdays
# Most runs are no-ops — checks thresholds (250 sends + 48h floor), exits if not ready
# When thresholds met: evaluates experiment, promotes winner, generates new challenger
# Disabled during warmup weeks 1-2 (auto-skips via warmup guard)
*/30 * * * 1-5 cd /home/ubuntu/convertra-leads && python3 orchestrator.py optimize >> /home/ubuntu/convertra-leads/logs/optimize.log 2>&1

# ─────────────────────────────────────────
# OPTIONAL: Adjust fill target
# ─────────────────────────────────────────

# Week 1 (conservative): 20 leads/day
# 0 7 * * 1-5 cd /home/ubuntu/convertra-leads && python3 orchestrator.py fill --target 20 >> /home/ubuntu/convertra-leads/logs/fill.log 2>&1

# Weeks 3+: Scale to 30-50 leads/day
# 0 7 * * 1-5 cd /home/ubuntu/convertra-leads && python3 orchestrator.py fill --target 40 >> /home/ubuntu/convertra-leads/logs/fill.log 2>&1

# Use a different Instantly campaign
# 0 7 * * 1-5 cd /home/ubuntu/convertra-leads && python3 orchestrator.py fill --target 25 --campaign-id "YOUR-CAMPAIGN-UUID" >> /home/ubuntu/convertra-leads/logs/fill.log 2>&1

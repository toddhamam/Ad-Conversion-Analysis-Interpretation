# Meta/Facebook API Configuration
VITE_META_APP_ID=your_meta_app_id
VITE_META_APP_SECRET=your_meta_app_secret
VITE_META_ACCESS_TOKEN=your_meta_access_token
VITE_META_AD_ACCOUNT_ID=act_your_ad_account_id
VITE_META_PAGE_ID=your_facebook_page_id

# OpenAI API Key — direct browser calls (recommended, no timeout limit)
# Set spending limits in OpenAI dashboard to mitigate browser exposure.
VITE_OPENAI_API_KEY=sk-your_openai_api_key
# OpenAI API Key — server-side fallback (used by /api/ai/* proxy, 60s limit)
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic (Claude) API Key — second AI provider for /api/ai/chat.
# Powers ConversionIQ™ analysis + interpretation (Claude Fable 5) AND acts as the
# automatic fallback whenever OpenAI can't serve a request (credits exhausted, rate
# limited, invalid key, outage). Also used by SEO IQ article generation.
# NOTE: this is API billing (console.anthropic.com) — a Claude Pro/Max subscription
# cannot be used by a deployed server.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
# Override the Claude model used for analysis (default: claude-fable-5)
# ANTHROPIC_ANALYSIS_MODEL=claude-fable-5
# Account-wide default provider for chat calls that don't pick one: openai | anthropic
# AI_PRIMARY_PROVIDER=openai

# Google Gemini API Key (for image generation - optional, used as primary if available)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Stripe Billing
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_id
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_enterprise_monthly_id
STRIPE_PRICE_ENTERPRISE_YEARLY=price_your_enterprise_yearly_id

# App URL (for Stripe redirects in production)
VITE_APP_URL=https://your-production-url.com

# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
